# General Translation credentials — https://generaltranslation.com
# Copy this file to .env (or let `npx gt auth` write .env.local) and fill in
# real values. .env and .env.local are gitignored; this example is committed.

# CLI (npx gt translate)
GT_PROJECT_ID=
GT_API_KEY=

# Dev-mode hot translation in the browser (npm run dev). gt-react reads these
# from import.meta.env automatically. Use a DEVELOPMENT key only — never a
# production API key, since VITE_ vars are exposed to the browser.
VITE_GT_PROJECT_ID=
VITE_GT_DEV_API_KEY=
