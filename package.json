{
  "name": "personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:mdx": "node scripts/sync-mdx-messages.js",
    "predev": "node scripts/sync-mdx-messages.js",
    "dev": "vite dev",
    "prehost": "node scripts/sync-mdx-messages.js",
    "host": "vite dev --host",
    "prebuild": "node scripts/sync-mdx-messages.js",
    "build": "vite build && tsc --noEmit",
    "start": "node scripts/serve.mjs",
    "translate": "node scripts/sync-mdx-messages.js && gt translate",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/sync-mdx-messages.js && node scripts/check-email-identities.mjs && oxlint --quiet . && oxfmt --check .",
    "lint:fix": "oxlint --quiet --fix . && oxfmt ."
  },
  "dependencies": {
    "@rrweb/record": "^2.1.1",
    "@rrweb/replay": "^2.1.1",
    "@tanstack/react-router": "^1.159.14",
    "@tanstack/react-start": "~1.159.14",
    "font-morph": "workspace:*",
    "gt-i18n": "1.0.16",
    "gt-react": "^11.1.12",
    "gt-rrweb": "workspace:*",
    "gt-tanstack-start": "^11.1.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@rrweb/types": "^2.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "gt": "^2.16.8",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
