{
  "name": "personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "glyphflux": "node repos/glyphflux/bin/glyphflux.js",
    "fonts:ja:build": "node scripts/build-japanese-font-subsets.mjs",
    "fonts:check": "node scripts/check-japanese-font-coverage.mjs",
    "sync:mdx": "node scripts/sync-mdx-messages.js",
    "resume:build": "node resume/build.js",
    "resume:check": "node resume/check.js",
    "resume:watch": "node resume/build.js --watch",
    "resume:sync": "node resume/build.js --sync-only",
    "test:resume": "node --test resume/content.test.js resume/check.test.js resume/i18n.test.js",
    "sync:glyphflux": "corepack pnpm --filter glyphflux build && corepack pnpm run glyphflux build",
    "sync:vendored": "corepack pnpm run sync:glyphflux && corepack pnpm --filter gt-rrweb build",
    "predev": "node scripts/sync-mdx-messages.js && corepack pnpm run sync:vendored && node resume/build.js",
    "dev": "vite dev",
    "prehost": "node scripts/sync-mdx-messages.js && corepack pnpm run sync:vendored && node resume/build.js",
    "host": "vite dev --host",
    "prebuild": "node scripts/sync-mdx-messages.js && corepack pnpm run sync:vendored",
    "build": "node resume/build.js && node resume/check.js && vite build && tsc --noEmit",
    "start": "node scripts/serve.mjs",
    "audit:security": "corepack pnpm audit --audit-level high",
    "test:security": "node scripts/security-regression.mjs",
    "test:accessibility": "node scripts/security-regression.mjs --accessibility",
    "test:preferences": "node scripts/security-regression.mjs --preferences-only",
    "test:contributions": "node scripts/test-contribution-session.mjs",
    "test:project-stars": "node scripts/test-project-stars.mjs",
    "test:experiments": "node scripts/test-site-experiments.mjs",
    "test:clipboard": "node scripts/test-clipboard.mjs",
    "test:font-endpoints": "node scripts/test-font-endpoints.mjs",
    "test:contribution-scroll": "node scripts/test-contribution-scroll.mjs",
    "test:page-memory": "node scripts/test-page-memory.mjs",
    "test:back-to-top": "node scripts/test-back-to-top.mjs",
    "test:locale-restoration": "node scripts/test-locale-restoration.mjs",
    "test:locale-switcher": "node scripts/test-locale-switcher.mjs",
    "test:print": "node scripts/test-print.mjs",
    "translate": "node scripts/sync-mdx-messages.js && gt translate && node scripts/sync-mdx-messages.js && corepack pnpm run sync:glyphflux",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/sync-mdx-messages.js && node scripts/check-email-identities.mjs && node scripts/check-japanese-font-coverage.mjs && oxlint --quiet . && oxfmt --check .",
    "lint:fix": "oxlint --quiet --fix . && oxfmt ."
  },
  "dependencies": {
    "@generaltranslation/format": "0.1.7",
    "@rrweb/record": "^2.1.1",
    "@rrweb/replay": "^2.1.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@vercel/analytics": "^2.0.1",
    "glyphflux": "workspace:*",
    "gt-i18n": "1.0.16",
    "gt-react": "^11.1.12",
    "gt-rrweb": "workspace:*",
    "gt-tanstack-start": "^11.1.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "@rrweb/types": "^2.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fontkit": "2.0.4",
    "gt": "^2.16.8",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.63.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
