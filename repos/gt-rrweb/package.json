{
  "name": "gt-rrweb",
  "version": "0.2.0",
  "description": "Record a product walkthrough once with rrweb and replay it per-locale using General Translation's own published translations",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@rrweb/record": ">=2.0.0",
    "@rrweb/replay": ">=2.0.0",
    "@rrweb/types": ">=2.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "font-morph": ">=0.0.0"
  },
  "peerDependenciesMeta": {
    "@rrweb/record": {
      "optional": true
    },
    "@rrweb/replay": {
      "optional": true
    },
    "font-morph": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:clean": "corepack pnpm run build",
    "build:release": "corepack pnpm run build:clean",
    "release": "corepack pnpm run build:clean && corepack pnpm publish",
    "release:alpha": "corepack pnpm run build:clean && corepack pnpm publish --tag alpha",
    "release:beta": "corepack pnpm run build:clean && corepack pnpm publish --tag beta",
    "release:latest": "corepack pnpm run build:clean && corepack pnpm publish --tag latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --quiet src e2e",
    "e2e": "corepack pnpm run build && node e2e/run.mjs",
    "e2e:fixture": "corepack pnpm run build && node e2e/make-fixture.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/generaltranslation/gt.git",
    "directory": "packages/rrweb"
  },
  "author": "General Translation, Inc.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/generaltranslation/gt/issues"
  },
  "homepage": "https://generaltranslation.com/",
  "devDependencies": {
    "@rrweb/record": "^2.1.1",
    "@rrweb/replay": "^2.1.1",
    "@rrweb/types": "^2.1.1",
    "@types/node": "^22.13.5",
    "@types/react": ">=18.0.0 <20.0.0",
    "@types/react-dom": ">=18.0.0 <20.0.0",
    "font-morph": "workspace:*",
    "morphdom": "^2.7.5",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.57.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./harvest": {
      "require": {
        "types": "./dist/harvest.d.cts",
        "default": "./dist/harvest.cjs"
      },
      "import": {
        "types": "./dist/harvest.d.mts",
        "default": "./dist/harvest.mjs"
      }
    },
    "./replay": {
      "require": {
        "types": "./dist/replay.d.cts",
        "default": "./dist/replay.cjs"
      },
      "import": {
        "types": "./dist/replay.d.mts",
        "default": "./dist/replay.mjs"
      }
    },
    "./font-morph": {
      "require": {
        "types": "./dist/font-morph.d.cts",
        "default": "./dist/font-morph.cjs"
      },
      "import": {
        "types": "./dist/font-morph.d.mts",
        "default": "./dist/font-morph.mjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "harvest": [
        "./dist/harvest.d.cts"
      ],
      "replay": [
        "./dist/replay.d.cts"
      ],
      "font-morph": [
        "./dist/font-morph.d.cts"
      ]
    }
  },
  "keywords": [
    "rrweb",
    "replay",
    "recorder",
    "demo",
    "react",
    "translation",
    "internationalization",
    "localization",
    "i18n"
  ]
}
