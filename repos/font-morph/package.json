{
  "name": "font-morph",
  "version": "0.0.0",
  "description": "A lightweight JavaScript library for morphing the same text between different fonts.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "styles.css"
  ],
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --quiet src e2e",
    "typecheck": "tsc --noEmit",
    "e2e": "corepack pnpm run build && node e2e/run.mjs"
  },
  "dependencies": {
    "kute.js": "2.2.6",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/opentype.js": "^1.3.10",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "playwright-core": "^1.57.0",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
