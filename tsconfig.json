{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "font-morph": ["repos/font-morph/src/index.ts"],
      "gt-rrweb": ["repos/gt-rrweb/src/index.ts"],
      "gt-rrweb/harvest": ["repos/gt-rrweb/src/harvest.ts"],
      "gt-rrweb/replay": ["repos/gt-rrweb/src/replay.ts"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"]
}
