{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "git submodule update --init --recursive && corepack pnpm install --frozen-lockfile",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), fullscreen=(self)"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "generaltranslation.locale", "value": "en" }],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "generaltranslation.locale", "value": "es" }],
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "generaltranslation.locale", "value": "ja" }],
      "destination": "/ja",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(?i)^\\s*es.*" }],
      "destination": "/es",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(?i)^\\s*ja.*" }],
      "destination": "/ja",
      "permanent": false
    },
    { "source": "/", "destination": "/en", "permanent": false }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/ssr" }]
}
