-                      gt-i18n custom events (the events-only fallback). -->
+                      gt-i18n custom events (the events-only fallback)
+       ?touch=1       convert the pointer clusters to touch tap clusters
+       ?offscreen=1   prepend an invalid off-frame pointer interaction
+       ?advance=1     exercise the deterministic onFrame advance directive. -->
 <html>
   <head>
     <meta charset="utf-8" />
@@ -51,14 +54,66 @@
       const params = new URLSearchParams(location.search);
       let bundle = await fetch('/fixture.json').then((r) => r.json());
       if (params.get('strip') === '1') bundle = { events: bundle.events };
+      if (params.get('touch') === '1') {
+        bundle = structuredClone(bundle);
+        bundle.events = bundle.events.map((event) => {
+          if (event.type !== 3 || event.data.source !== 2) return event;
+          if (event.data.type === 1) {
+            return {
+              ...event,
+              data: { ...event.data, type: 7, pointerType: 2 },
+            };
+          }
+          if (event.data.type === 0) {
+            return {
+              ...event,
+              data: { ...event.data, type: 9, pointerType: 2 },
+            };
+          }
+          if (event.data.type === 2) {
+            return { ...event, data: { ...event.data, pointerType: 2 } };
+          }
+          return event;
+        });
+      }
+      if (params.get('offscreen') === '1') {
+        bundle = structuredClone(bundle);
+        const snapshot = bundle.events.find((event) => event.type === 2);
+        bundle.events.splice(2, 0, {
+          type: 3,
+          timestamp: snapshot.timestamp + 10,
+          data: { source: 2, type: 1, id: -1, x: -200, y: 20 },
+        });
+      }
+      const frames = [];
+      let advanced = false;
       const handle = createGTReplayer(document.getElementById('app'), bundle, {
         initialLocale: params.get('locale') || undefined,
         switchLocalesAllowed: params.get('locales') !== 'off',
         debug: params.get('debug') === '1',
+        onFrame(frame) {
+          frames.push({
+            time: frame.time,
+            locale: frame.locale,
+            hasDocument: Boolean(frame.document),
+            scrollTop:
+              frame.document?.getElementById('scrollbox')?.scrollTop ?? null,
+          });
+          if (frames.length > 1000) frames.shift();
+          if (
+            params.get('advance') === '1' &&
+            !advanced &&
+            Number.isFinite(frame.time)
+          ) {
+            advanced = true;
+            return { advanceTo: 700 };
+          }
+        },
       });
       // Signals for the driver (run.mjs).
       window.__GT_REPLAYER_READY__ = true;
       window.__GT_REPLAYER_HANDLE__ = handle;
+      window.__GT_FRAMES__ = frames;
     </script>
   </body>
 </html>
